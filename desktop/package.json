{
  "name": "counterpick-fc-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "CounterPick FC - ứng dụng Windows tự đọc thư mục xuất từ Live Editor",
  "main": "main.js",
  "scripts": {
    "prepare-app": "node scripts/prepare-app.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win --publish never",
    "test": "node --test test/desktop.test.js",
    "e2e": "xvfb-run -a node test/e2e-electron.cjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "author": "CounterPick FC",
  "build": {
    "appId": "app.counterpickfc.desktop",
    "productName": "CounterPick FC",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "app/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "CounterPickFC-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CounterPickFC-Portable-${version}.${ext}"
    }
  }
}
